# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS).
# Local dev default is http://localhost:3000
# In production add your Vercel frontend URL, e.g. https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000

# Where new lead/contact notifications should be reviewed.
# (MVP stores leads in memory and logs them. Wire a real email provider later.)
LEADS_NOTIFY_EMAIL=owner@example.com
